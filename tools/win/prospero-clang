#!/usr/bin/env bash
# Windows counterpart of $PS5_PAYLOAD_SDK/bin/prospero-clang, for Git Bash and
# the native LLVM for Windows.
#
# Same flags as the SDK script, with one difference. The SDK script puts its
# own bin/ at the front of PATH so that clang finds the linker, prospero-lld,
# there. On Windows that file is a bash script without an extension: clang.exe
# finds it by name and then cannot start it. The SDK ships win/prospero-lld.exe
# for exactly this case, and -B points clang at it. clang 18 ignores -fuse-ld
# for the PS5 target, so -B is the way in.

SDK="${PS5_PAYLOAD_SDK:?PS5_PAYLOAD_SDK is not set}"
LLVM_BIN="${LLVM_BIN:-/c/Program Files/LLVM/bin}"
HBROOT="${SDK}/target/user/homebrew"

LIBS_CRT="${SDK}/target/lib/crt1.o"
LIBS_C="-lc"
LIBS_DEPS="-lSceLibcInternal -lSceNet"
LIBS_KERN="-lkernel_web"
TU=""

for ARG in "$@"; do
  if [[ "$ARG" == "-nostdlibc" || "$ARG" == "-nodefaultlibs" ]]; then
    LIBS_C=""
    LIBS_DEPS=""
    LIBS_KERN=""
  fi
  if [[ "$ARG" == "-lkernel" || "$ARG" == "-lkernel_sys" ||
        "$ARG" == "-lkernel_web" ]]; then
    LIBS_KERN=""
  fi
  if [[ "$ARG" == "-nostartfiles" || "$ARG" == "-c" || "$ARG" == "-shared" ]]; then
    LIBS_CRT=""
  fi
  if [[ ! "${ARG:0:1}" == "-" ]]; then
    TU="${ARG}"
  fi
done
if [[ "${TU}" == "" ]]; then
  LIBS_CRT=""
  LIBS_C=""
  LIBS_DEPS=""
  LIBS_KERN=""
fi

# As in the SDK script: clang 20 started appending the crt objects itself.
MAJOR="$("$LLVM_BIN/clang.exe" --version |
         sed -n 's/.*clang version \([0-9]*\).*/\1/p' | head -n 1)"
if [[ "${MAJOR:-0}" -ge 20 ]]; then
  export SCE_PROSPERO_SDK_DIR="${SDK}"
  LIBS_CRT=""
fi

# win/prospero-lld.exe passes the same layout options to ld.lld as the bash
# bin/prospero-lld — machine, -pie, the SDK linker script, --eh-frame-hdr,
# the 16 KB page size — except two, which are added here: --hash-style=gnu
# and the emulated-TLS flag for the LTO code generator. Without the first the
# image carries a SysV .hash table next to .gnu.hash, and it stops matching a
# build from Linux byte for byte. Harmless when only compiling (-c).
LINK_FIX="-Wl,--hash-style=gnu -Wl,-mllvm,-emulated-tls"

# win/prospero-lld.exe hands over to ld.lld, which it looks up in PATH.
# POSIX form on purpose: on the way through the native make.exe, LLVM_BIN
# arrives as C:/..., and the colon after the drive letter splits a bash PATH.
export PATH="$(cygpath -u "${LLVM_BIN}"):${PATH}"

exec "${LLVM_BIN}/clang.exe" \
     --start-no-unused-arguments \
     -target x86_64-sie-ps5 \
     -fvisibility-nodllstorageclass=default \
     -B "${SDK}/win" \
     -isysroot "${SDK}" \
     -isystem "${SDK}/target/include" \
     -L "${SDK}/target/lib" \
     -L "${HBROOT}/lib" \
     -fno-stack-protector -fno-plt -femulated-tls \
     $LIBS_C \
     --end-no-unused-arguments \
     "$@" \
     --start-no-unused-arguments \
     --sysroot "${SDK}" \
     $LIBS_CRT $LIBS_KERN $LIBS_DEPS \
     $LINK_FIX \
     --end-no-unused-arguments
